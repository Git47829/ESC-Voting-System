# ESC Voting System – Caddy reverse proxy
# https:// (bare scheme) matches all HTTPS connections regardless of hostname
# or IP, and tls internal + on_demand issues a local CA cert at handshake
# time for whatever identifier the client presents.
# HTTP (port 80) redirects to HTTPS automatically.
# OTel ingestion (4317/4318) is internal-only and not routed here.

{
	# Expose the admin API on all interfaces inside the container so that
	# Prometheus can scrape the /metrics endpoint on port 2019.
	admin 0.0.0.0:2019

	pki {
		ca local {
			name "ESC Voting Local CA"
		}
	}
}

# ── Access log (written once at the global/snippet level) ─────────────────────
# A named log sink that every virtual host below can reference by name.
# Writes newline-delimited JSON to a file that is bind-mounted into the
# OTel Collector container so the filelog receiver can tail it.
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size        100MiB
			roll_keep        5
			roll_keep_for    168h
			mode             0644
		}
		format json
	}
}

https:// {
	tls internal {
		on_demand
	}

	import access_log

	# ── Frontend (root) ───────────────────────────────────────────────────────
	# Catch-all, must be last so more specific handles below take priority.
	handle {
		reverse_proxy esc-frontend:3001
	}

	# ── CRUD REST API ─────────────────────────────────────────────────────────
	handle_path /crud-api/* {
		reverse_proxy db-crud-api:8000
	}

	# ── EuroStats ─────────────────────────────────────────────────────────────
	handle_path /eurostats/* {
		reverse_proxy eurostats:8880
	}

	# ── Public Vote Converter ──────────────────────────────────────────────────
	handle_path /esc-converter/* {
		reverse_proxy public-vote-converter:8090
	}

	# ── Grafana ───────────────────────────────────────────────────────────────
	# No prefix strip – Grafana serves under /grafana via GF_SERVER_ROOT_URL.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# ── Prometheus ────────────────────────────────────────────────────────────
	# Strip /prometheus prefix before forwarding – Prometheus serves at / internally.
	handle_path /prometheus* {
		reverse_proxy prometheus:9090
	}

	# ── Tempo ─────────────────────────────────────────────────────────────────
	handle_path /tempo/* {
		reverse_proxy tempo:3200
	}

	# ── Loki ──────────────────────────────────────────────────────────────────
	handle_path /loki/* {
		reverse_proxy loki:3100
	}
}

# Redirect plain HTTP → HTTPS, preserving the host used by the client.
http:// {
	redir https://{host}{uri} permanent
}
