# CRUD-DB-API base URL used by the React client.
# Use "/crud-api" behind Traefik, or "http://localhost:8000" for direct local API access.
VITE_CRUD_API_BASE_URL=/crud-api

# Optional explicit EuroStats WebSocket URL override.
# If unset, the client uses <current-origin>/eurostats/ws/stats.
VITE_EUROSTATS_WS_URL=
