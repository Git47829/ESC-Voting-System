MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
FLASK_SECRET_KEY=change-me
COOKIESIGNINGKEY=change-me
PHONESIGNINGKEY=<32 byte key ---> openssl rand -hex 32>
adminMail = <email of your admin>
adminPassword=<bcrypt hash of your admin password>
juryMail1 = <Mail of your first Jury Member>
juryPassword1=<bcrypt hash>
juryMail2 = <Mail of your second Jury Member>
juryPassword2=<bcrypt hash>
juryMail3 = <Mail of your third Jury Member>
juryPassword3=<bcrypt hash>
EuroMailURL = <URL to EuroMail>
RESEND_API_KEY = <Resend API Key>

# Cloudflare Tunnel Configuration
# Get these values from Cloudflare Dashboard after creating a tunnel
CLOUDFLARE_TUNNEL_NAME=<your-tunnel-name>
CLOUDFLARE_SECRET=<your-tunnel-token-from-cloudflare-dashboard>
