            "source_raw": [
              {
                "data": "#cloud-config\ndisable_root: false\nusers:\n  - name: ubuntu\n    groups: [sudo]\n    shell: /bin/bash\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    ssh_authorized_keys:\n      - ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY\n  - name: root\n    shell: /bin/bash\n    ssh_authorized_keys:\n      - ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY\npackage_update: true\npackages:\n  - curl\nruncmd:\n  - curl -sfL https://get.k3s.io | K3S_URL=https://192.168.178.110:6443 K3S_TOKEN=3d33fbd3b189e29390d9a50ed9908d970d9257527e590f8656db325f144f3497 sh -\n",
                "file_name": "k3s-agent-cloud-init.yaml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800
          },
