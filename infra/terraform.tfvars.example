proxmox_url       = "https://proxmox.example.local:8006/api2/json"
proxmox_api_token = "root@pam!terraform=replace-with-token-value"
proxmox_host      = "192.168.178.10"

ssh_public_key  = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyReplaceMe user@example"
node_login_user = "ubuntu"
k3s_token      = "replace-with-strong-k3s-shared-secret"

